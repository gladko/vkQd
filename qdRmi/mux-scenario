#
# RMI MUX scenario:  RMI calls go through MUX where the calls are routed to target server instance using some
# load balancing logic.
#
# Expected:
#   1. custom routing responses come from single server
#   2. default routing responses come from different servers
# Example:
# client:rmi@ayLzL,       custom routing response from: rmi@SYCHA,        default routing response from: rmi@SYCHA
# client:rmi@DGUpx,       custom routing response from: rmi@SYCHA,        default routing response from: rmi@gOfcS
# client:rmi@tqraZ,       custom routing response from: rmi@SYCHA,        default routing response from: rmi@gOfcS
# client:rmi@VnWWK,       custom routing response from: rmi@SYCHA,        default routing response from: rmi@SYCHA
# client:rmi@lTOIE,       custom routing response from: rmi@SYCHA,        default routing response from: rmi@gOfcS
# client:rmi@wbOdV,       custom routing response from: rmi@SYCHA,        default routing response from: rmi@gOfcS
# client:rmi@fgufs,       custom routing response from: rmi@SYCHA,        default routing response from: rmi@SYCHA
#
#
# MUXes
# :800X for servers
# :900X for clients. [advertise=none] means balancing on MUX. Otherwise, balancing (resolving target server instance)
#    will be executed on client.
#
./qds multiplexor --log logs/mux1.log :8001 :9001[advertise=none] -R --stat 10s
./qds multiplexor --log logs/mux2.log :8002 :9002[advertise=none] -R --stat 10s


#
# server connects to both MUXes
#
./client vk.vkPets.TestServerMain "(localhost:8001)(localhost:8002)"
./client vk.vkPets.TestServerMain "(localhost:8001)(localhost:8002)"


#
# client connects to a one arbitrary MUX, the second is fallback
#
./client vk.vkPets.TestClientMain "localhost:9001,localhost:9002"
./client vk.vkPets.TestClientMain "localhost:9001,localhost:9002"
./client vk.vkPets.TestClientMain "localhost:9001,localhost:9002"
./client vk.vkPets.TestClientMain "localhost:9001,localhost:9002"
./client vk.vkPets.TestClientMain "localhost:9001,localhost:9002"
./client vk.vkPets.TestClientMain "localhost:9001,localhost:9002"
./client vk.vkPets.TestClientMain "localhost:9001,localhost:9002"