#!/bin/bash

SCENARIO_FILE="$1"

if [[ ! -f "$SCENARIO_FILE" ]]; then
    echo "File not found: $SCENARIO_FILE"
    return 1
fi

# Symbol indicating the line should be joined with the next one
join_symbol=","
buffer=""

while IFS= read -r line || [[ -n "$line" ]]; do
    # Skip empty lines and lines starting with #
    [[ -z "$line" || "$line" == \#* ]] && continue

    # Remove any trailing carriage return (CTRL-M)
    line="${line//$'\r'/}"

    # Check if line ends with the join_symbol
    if [[ "$line" == *"$join_symbol" ]]; then
      # Remove the join_symbol and append to buffer
      buffer+="${line%$join_symbol}"
    else
      # Append the line and print buffer with the line
      buffer+="$line"
#      echo "--> $buffer"
      # Start the process in the background
      eval "$buffer" &
      echo "Started: '$buffer' with PID $!"
      buffer=""
    fi
done < "$SCENARIO_FILE"

